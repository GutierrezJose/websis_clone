generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model career {
  id_career                 Int                         @id @default(autoincrement())
  id_faculty                Int
  name                      String?                     @unique @db.VarChar(100)
  faculty                   faculty                     @relation(fields: [id_faculty], references: [id_faculty], onDelete: NoAction, onUpdate: NoAction)
  career_subject            career_subject[]
  student_enrollment_career student_enrollment_career[]
}

model career_subject {
  id_career_subject                            Int                          @id @default(autoincrement())
  id_career                                    Int
  id_subject                                   Int
  prerequisite                                 Int?
  level                                        String                       @db.VarChar(1)
  elective                                     Boolean
  career                                       career                       @relation(fields: [id_career], references: [id_career], onDelete: NoAction, onUpdate: NoAction)
  subject_career_subject_id_subjectTosubject   subject                      @relation("career_subject_id_subjectTosubject", fields: [id_subject], references: [id_subject], onDelete: NoAction, onUpdate: NoAction)
  subject_career_subject_prerequisiteTosubject subject?                     @relation("career_subject_prerequisiteTosubject", fields: [prerequisite], references: [id_subject], onDelete: NoAction, onUpdate: NoAction)
  group                                        group[]
  professor_career_subject                     professor_career_subject[]
  student_enrollment_subject                   student_enrollment_subject[]
}

model grade {
  id_grade      Int                         @id @default(autoincrement())
  id_enrollment Int?
  first_exam    BigInt?
  second_examen BigInt?
  final_exam    BigInt?
  grade         BigInt?
  status        String?                     @db.VarChar(100)
  enrollment    student_enrollment_subject? @relation(fields: [id_enrollment], references: [id_enrollment], onDelete: NoAction, onUpdate: NoAction, map: "grade_id_user_career_subject_fkey")
}

model period {
  id_period                  Int                          @id @default(autoincrement())
  name                       String                       @unique @db.VarChar(100)
  student_enrollment_subject student_enrollment_subject[]
}

model rol {
  id_rol   Int        @id @default(autoincrement())
  name     String     @unique @db.VarChar(30)
  user_rol user_rol[]
}

model subject {
  id_subject                                          Int              @id @default(autoincrement())
  name                                                String           @unique @db.VarChar(255)
  career_subject_career_subject_id_subjectTosubject   career_subject[] @relation("career_subject_id_subjectTosubject")
  career_subject_career_subject_prerequisiteTosubject career_subject[] @relation("career_subject_prerequisiteTosubject")
}

model user {
  id_user                    Int                          @id @default(autoincrement())
  username                   String                       @unique @db.VarChar(50)
  password                   String                       @db.VarChar(255)
  first_name                 String?                      @db.VarChar(100)
  last_name                  String?                      @db.VarChar(100)
  ci                         Int
  birthdate                  DateTime?                    @db.Date
  address                    String?                      @db.VarChar(255)
  phone                      String?                      @db.VarChar(50)
  professor_career_subject   professor_career_subject[]
  student_enrollment_career  student_enrollment_career[]
  student_enrollment_subject student_enrollment_subject[]
  user_rol                   user_rol[]
}

model user_rol {
  id_user_rol Int  @id @default(autoincrement())
  id_user     Int
  id_rol      Int
  rol         rol  @relation(fields: [id_rol], references: [id_rol], onDelete: NoAction, onUpdate: NoAction)
  user        user @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction)
}

model faculty {
  id_faculty Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(50)
  career     career[]
}

model student_enrollment_career {
  id_student_career Int     @id(map: "user_career_pkey") @default(autoincrement())
  id_user           Int?
  id_career         Int?
  career            career? @relation(fields: [id_career], references: [id_career], onDelete: NoAction, onUpdate: NoAction, map: "user_career_id_career_fkey")
  user              user?   @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "user_career_id_user_fkey")
}

model student_enrollment_subject {
  id_enrollment     Int             @id(map: "user_career_subject_pkey") @default(autoincrement())
  id_user           Int?
  id_career_subject Int?
  id_period         Int?
  id_group          Int?
  year              String          @db.VarChar(255)
  grade             grade[]
  group             group?          @relation(fields: [id_group], references: [id_group], onDelete: NoAction, onUpdate: NoAction)
  career_subject    career_subject? @relation(fields: [id_career_subject], references: [id_career_subject], onDelete: NoAction, onUpdate: NoAction, map: "user_career_subject_id_career_subject_fkey")
  period            period?         @relation(fields: [id_period], references: [id_period], onDelete: NoAction, onUpdate: NoAction, map: "user_career_subject_id_period_fkey")
  user              user?           @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "user_career_subject_id_user_fkey")
}

model class_schedule {
  id_class_schedule    Int                    @id @default(autoincrement())
  schedule             String?                @db.VarChar(5)
  group_class_schedule group_class_schedule[]
}

model classroom {
  id_classroom    Int               @id @default(autoincrement())
  classroom_name  String?           @db.VarChar(50)
  group_classroom group_classroom[]
}

model group {
  id_group                   Int                          @id @default(autoincrement())
  id_career_subject          Int?
  group_name                 String?                      @db.VarChar(2)
  career_subject             career_subject?              @relation(fields: [id_career_subject], references: [id_career_subject], onDelete: NoAction, onUpdate: NoAction)
  group_class_schedule       group_class_schedule[]
  group_classroom            group_classroom[]
  student_enrollment_subject student_enrollment_subject[]
}

model group_class_schedule {
  id_group_class_schedule Int             @id @default(autoincrement())
  id_group                Int?
  id_class_schedule       Int?
  class_schedule          class_schedule? @relation(fields: [id_class_schedule], references: [id_class_schedule], onDelete: NoAction, onUpdate: NoAction)
  group                   group?          @relation(fields: [id_group], references: [id_group], onDelete: NoAction, onUpdate: NoAction)
}

model group_classroom {
  id_group_classroom Int        @id @default(autoincrement())
  id_group           Int?
  id_classroom       Int?
  classroom          classroom? @relation(fields: [id_classroom], references: [id_classroom], onDelete: NoAction, onUpdate: NoAction)
  group              group?     @relation(fields: [id_group], references: [id_group], onDelete: NoAction, onUpdate: NoAction)
}

model professor_career_subject {
  id_professor_subject Int             @id(map: "user_subject_pkey") @default(autoincrement())
  id_user              Int?
  id_career_subject    Int?
  career_subject       career_subject? @relation(fields: [id_career_subject], references: [id_career_subject], onDelete: NoAction, onUpdate: NoAction)
  user                 user?           @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "user_subject_id_user_fkey")
}
